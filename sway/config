# ==============================================================================
#  sway — Tokyo Night rice
#  - Gaps 3px, border pixel vuông sắc
#  - Bar: waybar siêu tối giản
#  - Reload config: $mod+Shift+c
# ==============================================================================

# ---- Variables ---------------------------------------------------------------
set $mod Mod4
set $term foot
set $menu ~/.config/sway/scripts/launcher.sh
set $scripts ~/.config/sway/scripts

# Tokyo Night palette
set $bg     #1a1b26
set $bg_dk  #16161e
set $bg_hi  #292e42
set $fg     #c0caf5
set $fg_dim #565f89
set $blue   #7aa2f7
set $purple #bb9af7
set $green  #9ece6a
set $red    #f7768e

# ---- Output / Wallpaper (solid Tokyo Night — thay bằng ảnh sau nếu muốn) ------
# Muốn dùng ảnh: output * bg ~/Pictures/wall.png fill
output * bg $bg solid_color

# ---- Input --------------------------------------------------------------------
input type:keyboard {
    xkb_layout us
    repeat_delay 250
    repeat_rate 35
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
seat seat0 hide_cursor 3000

# ---- Appearance ----------------------------------------------------------------
font pango:JetBrainsMono Nerd Font 10

gaps inner 3
gaps outer 0
smart_gaps on
default_border pixel 2
default_floating_border pixel 2
smart_borders on

#                     border    bg       text     indicator child_border
client.focused          $blue   $bg      $fg      $blue     $blue
client.focused_inactive $bg_hi  $bg      $fg_dim  $bg_hi    $bg_hi
client.unfocused        $bg_dk  $bg_dk   $fg_dim  $bg_dk    $bg_dk
client.urgent           $red    $bg      $fg      $red      $red
client.placeholder      $bg_dk  $bg_dk   $fg_dim  $bg_dk    $bg_dk

# ---- Bar: waybar (config ở ~/.config/waybar/) ----------------------------------
bar {
    swaybar_command waybar
}

# ---- Window rules ---------------------------------------------------------------
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable

# ---- Autostart -------------------------------------------------------------------
exec mako
exec /usr/lib/polkit-kde-authentication-agent-1
exec autotiling

# Clipboard history: lưu mọi thứ copy vào cliphist
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Khóa màn hình sau 5 phút, tắt màn hình sau 10 phút
exec swayidle -w \
    timeout 300 "$scripts/lock.sh" \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep "$scripts/lock.sh"

# Bắt buộc để screen sharing / portal hoạt động đúng
exec_always {
    systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
}

# ---- Keybinds: cơ bản -------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Thoát sway?' -B 'Thoát' 'swaymsg exit'
bindsym $mod+Shift+x exec $scripts/lock.sh

# Focus kiểu vim
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Di chuyển window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout
# bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+a focus parent
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle

# gaps: bấm $mod+g rồi +/-/0, Enter để thoát
mode "gaps" {
    bindsym plus  gaps inner all plus 3
    bindsym minus gaps inner all minus 3
    bindsym 0     gaps inner all set 0
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+g mode "gaps"

# Resize mode
mode "resize" {
    bindsym h resize shrink width 20 px
    bindsym j resize grow height 20 px
    bindsym k resize shrink height 20 px
    bindsym l resize grow width 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---- Screenshot & clipboard --------------------------------------------------------
bindsym Print       exec $scripts/screenshot.sh full
bindsym Shift+Print exec $scripts/screenshot.sh area
bindsym $mod+c      exec $scripts/clipboard.sh

# ---- Workspaces ---------------------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# ---- Volume & độ sáng -----------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec pamixer -ui 5
bindsym XF86AudioLowerVolume exec pamixer -ud 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ---- Drag window bằng $mod + chuột -------------------------------------------------------
floating_modifier $mod normal

# Ghi đè file .desktop custom của bạn ở đây nếu có
include ~/.config/sway/config.d/*
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+b exec thorium-browser
bindsym $mod+Shift+b splith
bindsym $mod+slash exec ~/.config/sway/scripts/keybinds.sh
# Quan ly mang & bluetooth
bindsym $mod+n exec $scripts/wifi.sh
bindsym $mod+m exec blueman-manager
